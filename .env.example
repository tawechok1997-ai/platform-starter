NODE_ENV=development
PORT=4000
API_PORT=4000
MEMBER_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ENABLE_DEMO_TOURNAMENT_DATA=false
API_PUBLIC_URL=http://localhost:4000

# Number of trusted reverse-proxy hops. Keep 0 when the API is directly exposed.
TRUSTED_PROXY_HOPS=0

DATABASE_URL=postgresql://platform:platform@localhost:5432/platform?schema=public
REDIS_URL=redis://localhost:6379

# Private media and object storage. Use local only for development or a single approved persistent volume.
PRIVATE_MEDIA_DIR=/tmp/platform-private-media
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/tmp/platform-object-storage
STORAGE_SIGNING_SECRET=set_in_local_env
STORAGE_MALWARE_SCAN_MODE=disabled
STORAGE_MALWARE_SCAN_URL=
STORAGE_MALWARE_SCAN_SECRET=

# S3/R2-compatible storage. Required when STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

JWT_ACCESS_KEY=set_in_local_env
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
ADMIN_JWT_ACCESS_TTL=10m
ADMIN_REFRESH_TTL_HOURS=12

# Use independent random values of at least 32 characters in production.
TWO_FACTOR_ENCRYPTION_KEY=set_in_local_env
GAME_CREDENTIAL_SECRET=set_in_local_env
ANTIBOT_ENCRYPTION_KEY=set_in_local_env

# Keep the simulator disabled in production. API_PUBLIC_URL is required when it is enabled in a deployed environment.
ENABLE_PROVIDER_SIMULATOR=false
GAME_PROVIDER_MODE=SIMULATOR
REAL_MONEY_PROVIDER_ENABLED=false
EXTERNAL_PROVIDER_CALLBACK_ENABLED=false
SEAMLESS_WALLET_ENABLED=false
ALLOW_PLACEHOLDER_GAME_ASSETS=true
PROVIDER_SIMULATOR_API_KEY=simulator-api-key
PROVIDER_SIMULATOR_MERCHANT_ID=simulator-merchant
PROVIDER_SIMULATOR_SECRET=simulator-secret
PROVIDER_SIMULATOR_RATE_LIMIT_PER_MINUTE=120

# Endpoint-specific minute limits. Adjust only from observed traffic and retained evidence.
RATE_LIMIT_MEMBER_LOGIN_PER_MINUTE=10
RATE_LIMIT_MEMBER_REGISTER_PER_MINUTE=8
RATE_LIMIT_PASSWORD_RESET_REQUEST_PER_MINUTE=5
RATE_LIMIT_PASSWORD_RESET_CONFIRM_PER_MINUTE=5
RATE_LIMIT_ADMIN_LOGIN_PER_MINUTE=10
RATE_LIMIT_ADMIN_2FA_PER_MINUTE=10
RATE_LIMIT_ADMIN_REFRESH_PER_MINUTE=30
RATE_LIMIT_TOPUPS_PER_MINUTE=20
RATE_LIMIT_SLIP_UPLOAD_PER_MINUTE=12
RATE_LIMIT_WITHDRAWALS_PER_MINUTE=12
RATE_LIMIT_PROVIDER_WEBHOOK_PER_MINUTE=120

# Internal service that delivers password-reset links to the member.
PASSWORD_RESET_DELIVERY_ENABLED=true
PASSWORD_RESET_DELIVERY_WEBHOOK_URL=http://localhost:4100/password-reset
PASSWORD_RESET_DELIVERY_WEBHOOK_SECRET=set_in_local_env
# Local development only. Never enable in production.
PASSWORD_RESET_EXPOSE_TOKEN=false

ADMIN_OTP_FOR_DEV=000000
ADMIN_OTP_ISSUER=Platform Admin
DEFAULT_ADMIN_SECRET=set_in_local_env

# First production Admin bootstrap. Used only while admin_users is empty.
# Prefer setting these as private Railway variables rather than relying on DEFAULT_ADMIN_SECRET.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=set_in_local_env
