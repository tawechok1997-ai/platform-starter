{
  "name": "@platform/web-member",
  "private": true,
  "scripts": {
    "generate:asset-basename-map": "node tools/generate-local-asset-basename-map.mjs",
    "audit:source-cdn-assets": "node tools/audit-source-cdn-asset-basename-matches.mjs",
    "predev": "pnpm generate:asset-basename-map",
    "dev": "next dev -p 3000",
    "preanalyze": "pnpm generate:asset-basename-map && pnpm audit:source-cdn-assets",
    "analyze": "ANALYZE=true next build",
    "prebuild": "pnpm generate:asset-basename-map && pnpm audit:source-cdn-assets",
    "build": "next build",
    "prelint": "pnpm generate:asset-basename-map",
    "lint": "eslint app src --ext .ts,.tsx",
    "pretest": "pnpm generate:asset-basename-map",
    "test": "node --import tsx --test \"src/**/*.spec.ts\" \"app/**/*.spec.ts\"",
    "pretypecheck": "pnpm generate:asset-basename-map",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "audit:reference-assets": "node tools/audit-reference-assets.mjs",
    "verify": "pnpm audit:reference-assets && pnpm audit:source-cdn-assets && pnpm test && pnpm typecheck && pnpm build",
    "start": "node tools/start-production.mjs"
  },
  "dependencies": {
    "next": "15.5.21",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@platform/api-client": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "@types/node": "22.10.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
